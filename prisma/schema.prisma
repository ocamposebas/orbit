generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                      String        @id @default(cuid())
  name                    String
  slug                    String        @unique
  isDemo                  Boolean       @default(false)
  snapshotRetentionDays   Int           @default(365)
  screenshotRetentionDays Int           @default(90)
  scanRetentionDays       Int           @default(365)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  alerts                  Alert[]
  auditLogs               AuditLog[]
  findings                Finding[]
  aiFindings              AiFinding[]
  integrations            Integration[]
  memberships             Membership[]
  merchants               Merchant[]
  sessions                Session[]
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String?
  passwordHash      String?
  active            Boolean          @default(true)
  lastLoginAt       DateTime?
  passwordUpdatedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  auditLogs         AuditLog[]
  reviews           FindingReview[]
  memberships       Membership[]
  merchantAccess    MerchantAccess[]
  sessions          Session[]
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  ipHash         String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Merchant {
  id                    String                       @id @default(cuid())
  organizationId        String
  businessName          String
  slug                  String
  industry              String
  country               String
  legalCountry          String?
  platformFeeBps        Int?                         @default(300)
  businessDescription   String
  expectedMonthlyVolume String?
  status                MerchantStatus               @default(ONBOARDING)
  isDemo                Boolean                      @default(false)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  alerts                Alert[]
  auditLogs             AuditLog[]
  findings              Finding[]
  healthScores          HealthScore[]
  aiFindings            AiFinding[]
  aiScans               AiScan[]
  accessGrants          MerchantAccess[]
  agreement             MerchantAgreement?
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites                 MerchantSite[]
  policies              Policy[]
  paymentTransactions   PaymentTransaction[]
  products              Product[]
  scans                 Scan[]
  stripeConnect         StripeConnectIntegration?
  wooCommerceRelay      WooCommerceRelayIntegration?

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model MerchantAgreement {
  id                       String          @id @default(cuid())
  merchantId               String          @unique
  status                   AgreementStatus @default(INVITED)
  invitationTokenHash      String          @unique
  invitationExpiresAt      DateTime
  invitationIssuedAt       DateTime?
  termsVersion             String          @default("orbit-msa-en-1.2")
  selfServe                Boolean         @default(false)
  legalName                String?
  tradeName                String?
  entityType               String?
  taxId                    String?
  registrationNumber       String?
  businessAddress          String?
  city                     String?
  region                   String?
  postalCode               String?
  countryCode              String?
  coveredDomains           String?
  primaryContactName       String?
  primaryContactRole       String?
  primaryContactEmail      String?
  primaryContactPhone      String?
  billingDescriptor        String?
  estimatedMonthlyVolume   String?
  averageTransactionAmount String?
  highestTransactionAmount String?
  productsAndServices      String?
  informationCertifiedAt   DateTime?
  contractIssuedAt         DateTime?
  contractPdf              Bytes?
  contractSha256           String?
  signedOriginalName       String?
  signedMimeType           String?
  signedSizeBytes          Int?
  signedContract           Bytes?
  signedSha256             String?
  signedUploadedAt         DateTime?
  lockedAt                 DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  merchant                 Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([invitationExpiresAt])
}

model StripeConnectIntegration {
  id                              String                     @id @default(cuid())
  merchantId                      String                     @unique
  stripeAccountId                 String                     @unique
  stripeEnvironment               StripeEnvironment
  accountApiVersion               StripeAccountApiVersion    @default(V2)
  displayStatus                   StripeConnectDisplayStatus @default(ONBOARDING)
  cardPaymentsStatus              String?
  payoutsStatus                   String?
  requirementsCurrentlyDue        Json                       @default("[]")
  requirementsEventuallyDue       Json                       @default("[]")
  requirementsPastDue             Json                       @default("[]")
  requirementsPendingVerification Json                       @default("[]")
  futureRequirements              Json                       @default("[]")
  statusDetails                   Json                       @default("[]")
  disabledReason                  String?
  onboardingStartedAt             DateTime?
  onboardingCompletedAt           DateTime?
  lastSyncedAt                    DateTime?
  rawStripeState                  Json                       @default("{}")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  merchant                        Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  events                          StripeConnectEvent[]

  @@index([stripeEnvironment, displayStatus])
}

model StripeConnectEvent {
  id              String                    @id @default(cuid())
  stripeEventId   String                    @unique
  stripeAccountId String?
  integrationId   String?
  type            String
  livemode        Boolean
  status          StripeConnectEventStatus  @default(PROCESSING)
  processedAt     DateTime?
  errorCode       String?
  createdAt       DateTime                  @default(now())
  integration     StripeConnectIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([stripeAccountId, createdAt])
  @@index([status, createdAt])
}

model WooCommerceRelayIntegration {
  id                      String                      @id @default(cuid())
  merchantId              String                      @unique
  baseUrl                 String
  environment             WooCommerceRelayEnvironment
  connectionEnabled       Boolean                     @default(true)
  encryptedSigningSecret  String
  connectionStatus        WooCommerceRelayStatus      @default(CONFIGURED)
  relayVersion            String?
  woocommerceAvailable    Boolean?
  lastHealthCheckAt       DateTime?
  lastSuccessfulRequestAt DateTime?
  lastLatencyMs           Int?
  lastErrorCode           String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  merchant                Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([environment, connectionStatus])
}

model PaymentTransaction {
  id                    String                   @id
  merchantId            String
  wooOrderId            String
  stripeAccountId       String
  amountMinor           Int
  currency              String
  platformFeeBps        Int
  platformFeeMinor      Int
  stripePaymentIntentId String?                  @unique
  wooCompletedAt        DateTime?
  status                PaymentTransactionStatus @default(CREATED)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  merchant              Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentEvents         StripePaymentEvent[]

  @@unique([merchantId, wooOrderId])
  @@index([stripeAccountId, status])
}

model StripePaymentEvent {
  id                    String                   @id @default(cuid())
  stripeEventId         String                   @unique
  transactionId         String?
  stripePaymentIntentId String?
  stripeAccountId       String?
  type                  String
  livemode              Boolean
  status                StripePaymentEventStatus @default(PROCESSING)
  errorCode             String?
  processedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  transaction           PaymentTransaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@index([stripeAccountId, status])
}

model MerchantAccess {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model MerchantSite {
  id                       String          @id @default(cuid())
  merchantId               String
  url                      String
  normalizedUrl            String
  hostname                 String
  environment              SiteEnvironment @default(PRODUCTION)
  active                   Boolean         @default(true)
  lastScannedAt            DateTime?
  monitoringCadenceMinutes Int             @default(1440)
  nextScanAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  findings                 Finding[]
  merchant                 Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  policies                 Policy[]
  products                 Product[]
  scans                    Scan[]
  pages                    ScanPage[]
  aiScans                  AiScan[]

  @@unique([merchantId, normalizedUrl])
  @@index([hostname])
}

model Scan {
  id                     String                  @id @default(cuid())
  merchantId             String
  siteId                 String
  mode                   ScanMode
  status                 ScanStatus              @default(QUEUED)
  progress               Json                    @default("{}")
  targetUrls             Json?
  pagesDiscovered        Int                     @default(0)
  pagesProcessed         Int                     @default(0)
  productsDetected       Int                     @default(0)
  policiesDetected       Int                     @default(0)
  findingsCreated        Int                     @default(0)
  findingsResolved       Int                     @default(0)
  scoreBefore            Int?
  scoreAfter             Int?
  startedAt              DateTime?
  completedAt            DateTime?
  error                  String?
  intelligence           Json                    @default("{}")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  auditLogs              AuditLog[]
  findings               Finding[]
  healthScores           HealthScore[]
  changes                PageChange[]
  merchant               Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  site                   MerchantSite            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages                  ScanPage[]
  evidenceArtifacts      EvidenceArtifact[]
  reviewRuns             ReviewRun[]
  verificationAssertions VerificationAssertion[]
  adjudicationDecisions  AdjudicationDecision[]

  @@index([merchantId, createdAt])
  @@index([status, createdAt])
}

model ScanPage {
  id                       String         @id @default(cuid())
  scanId                   String
  siteId                   String
  url                      String
  canonicalUrl             String?
  httpStatus               Int?
  contentType              String?
  title                    String?
  metaDescription          String?
  canonicalTag             String?
  robotsDirectives         String?
  discoveredFrom           String?
  depth                    Int            @default(0)
  pageType                 PageType       @default(OTHER)
  classificationConfidence Float          @default(0)
  classificationReasons    Json           @default("[]")
  normalizedContent        Json?
  contentHash              String?
  inaccessibleReason       String?
  firstSeenAt              DateTime       @default(now())
  lastSeenAt               DateTime       @default(now())
  createdAt                DateTime       @default(now())
  changes                  PageChange[]
  snapshots                PageSnapshot[]
  scan                     Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  site                     MerchantSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([scanId, url])
  @@index([siteId, url])
  @@index([pageType])
}

model PageSnapshot {
  id                String            @id @default(cuid())
  scanPageId        String
  contentHash       String
  semanticHash      String?
  normalizedContent Json
  visibleText       String
  capturedAt        DateTime          @default(now())
  evidence          FindingEvidence[]
  currentChanges    PageChange[]      @relation("CurrentSnapshot")
  previousChanges   PageChange[]      @relation("PreviousSnapshot")
  scanPage          ScanPage          @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@index([scanPageId, capturedAt])
  @@index([contentHash])
}

model PageChange {
  id                 String        @id @default(cuid())
  scanId             String
  scanPageId         String
  previousSnapshotId String?
  currentSnapshotId  String
  type               ChangeType
  riskImpact         RiskImpact    @default(NONE)
  diff               Json
  summary            String?
  createdAt          DateTime      @default(now())
  currentSnapshot    PageSnapshot  @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id])
  previousSnapshot   PageSnapshot? @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id])
  scan               Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanPage           ScanPage      @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@index([scanId, riskImpact])
}

model Product {
  id           String            @id @default(cuid())
  merchantId   String
  siteId       String
  canonicalUrl String
  name         String
  sku          String?
  currentPrice Decimal?          @db.Decimal(12, 2)
  availability String?
  categories   Json              @default("[]")
  disclaimers  Json              @default("[]")
  claims       Json              @default("[]")
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  merchant     Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  site         MerchantSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshots    ProductSnapshot[]
  variants     ProductVariant[]

  @@unique([merchantId, canonicalUrl])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String
  sku           String?
  concentration String?
  size          String?
  price         Decimal? @db.Decimal(12, 2)
  availability  String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSnapshot {
  id        String   @id @default(cuid())
  productId String
  scanId    String
  data      Json
  hash      String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model Policy {
  id          String           @id @default(cuid())
  merchantId  String
  siteId      String
  type        PolicyType
  coverage    PolicyCoverage
  url         String?
  currentHash String?
  clauses     Json             @default("[]")
  updatedAt   DateTime         @updatedAt
  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  site        MerchantSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshots   PolicySnapshot[]

  @@unique([merchantId, siteId, type])
}

model PolicySnapshot {
  id        String         @id @default(cuid())
  policyId  String
  scanId    String
  text      String
  textHash  String
  coverage  PolicyCoverage
  clauses   Json           @default("[]")
  createdAt DateTime       @default(now())
  policy    Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

model RuleSet {
  id            String    @id @default(cuid())
  code          String
  version       Int
  name          String
  description   String
  industry      String?
  enabled       Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  rules         Rule[]

  @@unique([code, version])
}

model Rule {
  id             String        @id @default(cuid())
  ruleSetId      String
  key            String
  currentVersion Int           @default(1)
  enabled        Boolean       @default(true)
  ruleSet        RuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  versions       RuleVersion[]

  @@unique([ruleSetId, key])
}

model RuleVersion {
  id                  String         @id @default(cuid())
  ruleId              String
  version             Int
  name                String
  description         String
  category            String
  severity            Severity
  evaluationType      EvaluationType
  appliesTo           PageType?
  condition           Json
  remediationGuidance String
  sourceName          String?
  sourceUrl           String?
  sourceLastReviewed  DateTime?
  jurisdiction        String?
  effectiveFrom       DateTime       @default(now())
  effectiveTo         DateTime?
  createdAt           DateTime       @default(now())
  findings            Finding[]
  rule                Rule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
}

model Finding {
  id                String                @id @default(cuid())
  organizationId    String
  merchantId        String
  siteId            String
  scanId            String
  ruleVersionId     String?
  severity          Severity
  confidence        Float
  status            FindingStatus         @default(OPEN)
  category          String
  title             String
  description       String
  url               String
  pageType          PageType
  detectedText      String?
  reason            String
  recommendedAction String
  fingerprint       String
  firstDetectedAt   DateTime              @default(now())
  lastDetectedAt    DateTime              @default(now())
  resolvedAt        DateTime?
  resolvedByScanId  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  adjudicationId    String?               @unique
  alerts            Alert[]
  merchant          Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleVersion       RuleVersion?          @relation(fields: [ruleVersionId], references: [id])
  scan              Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  site              MerchantSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  evidence          FindingEvidence[]
  reviews           FindingReview[]
  remediations      Remediation[]
  adjudication      AdjudicationDecision? @relation(fields: [adjudicationId], references: [id])

  @@unique([merchantId, fingerprint, firstDetectedAt])
  @@index([organizationId, status, severity])
  @@index([merchantId, lastDetectedAt])
}

model FindingEvidence {
  id                       String          @id @default(cuid())
  findingId                String
  snapshotId               String?
  evidenceRecordId         String?
  kind                     EvidenceKind
  pageUrl                  String
  normalizedText           String?
  evidenceSnippet          String?
  pageHash                 String
  domSelector              String?
  storageKey               String?
  ruleVersion              String?
  modelVersion             String?
  classificationConfidence Float?
  metadata                 Json            @default("{}")
  createdAt                DateTime        @default(now())
  finding                  Finding         @relation(fields: [findingId], references: [id], onDelete: Cascade)
  snapshot                 PageSnapshot?   @relation(fields: [snapshotId], references: [id])
  evidenceRecord           EvidenceRecord? @relation(fields: [evidenceRecordId], references: [id])

  @@index([findingId, createdAt])
  @@index([evidenceRecordId])
}

model FindingReview {
  id         String         @id @default(cuid())
  findingId  String
  reviewerId String?
  decision   ReviewDecision
  note       String?
  createdAt  DateTime       @default(now())
  finding    Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation(fields: [reviewerId], references: [id])
}

model Remediation {
  id          String    @id @default(cuid())
  findingId   String
  status      String
  owner       String?
  note        String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finding     Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model HealthScore {
  id             String                 @id @default(cuid())
  merchantId     String
  scanId         String
  total          Int
  formulaVersion String
  explanation    Json
  createdAt      DateTime               @default(now())
  merchant       Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  scan           Scan                   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  components     HealthScoreComponent[]

  @@unique([merchantId, scanId])
}

model HealthScoreComponent {
  id            String      @id @default(cuid())
  healthScoreId String
  key           String
  label         String
  score         Int
  deductions    Json
  healthScore   HealthScore @relation(fields: [healthScoreId], references: [id], onDelete: Cascade)
}

model Alert {
  id             String       @id @default(cuid())
  organizationId String
  merchantId     String
  findingId      String?
  status         AlertStatus  @default(OPEN)
  title          String
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  finding        Finding?     @relation(fields: [findingId], references: [id])
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider @default(GENERIC)
  name            String
  status          String
  encryptedConfig Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  merchantId     String?
  scanId         String?
  aiScanId       String?
  action         String
  targetType     String
  targetId       String
  metadata       Json         @default("{}")
  requestId      String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  merchant       Merchant?    @relation(fields: [merchantId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan           Scan?        @relation(fields: [scanId], references: [id])
  aiScan         AiScan?      @relation(fields: [aiScanId], references: [id])

  @@index([organizationId, createdAt])
  @@index([merchantId, createdAt])
  @@index([aiScanId, createdAt])
}

model WorkerHeartbeat {
  id            String     @id @default(cuid())
  workerId      String     @unique
  type          WorkerType
  status        String
  currentScanId String?
  metadata      Json       @default("{}")
  lastSeenAt    DateTime   @default(now())
  startedAt     DateTime   @default(now())
}

/// ORBIT AI Scanner v1 audit job. Legacy scanner tables above remain mapped only
/// so existing data can be recovered without a destructive migration.
model AiScan {
  id               String           @id @default(cuid())
  merchantId       String
  siteId           String
  status           AiScanStatus     @default(QUEUED)
  model            String           @default("gpt-5.6-luna")
  criticModel      String?
  budget           Json
  coverage         Json             @default("{}")
  usage            Json             @default("{}")
  observations     Json             @default("[]")
  summary          String?
  limitations      Json             @default("[]")
  score            Int?
  scoreBreakdown   Json             @default("{}")
  resumeCheckpoint Json             @default("{}")
  resumeAfter      DateTime?
  resumeCount      Int              @default(0)
  manualReportStorageKey String?
  manualReportOriginalName String?
  manualReportMimeType String?
  manualReportSizeBytes Int?
  manualReportSha256 String?
  manualReportUploadedAt DateTime?
  manualReportUploadedById String?
  runtimeMs        Int              @default(0)
  toolCalls        Int              @default(0)
  failureCode      AiFailureCode?
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  site             MerchantSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  evidence         AiEvidence[]
  findings         AiFinding[]
  products         AiProduct[]
  toolEvents       AiToolEvent[]
  criticReviews    AiCriticReview[]
  auditLogs        AuditLog[]

  @@index([merchantId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([status, resumeAfter])
}

model AiEvidence {
  id             String              @id @default(cuid())
  scanId         String
  toolName       String
  kind           AiEvidenceKind
  sourceUrl      String
  destinationUrl String?
  firstParty     Boolean             @default(true)
  exactText      String?
  surroundingDom Json?
  storageKey     String?
  mimeType       String?
  sha256         String
  metadata       Json                @default("{}")
  validated      Boolean             @default(false)
  capturedAt     DateTime            @default(now())
  scan           AiScan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingLinks   AiFindingEvidence[]

  @@unique([scanId, sha256])
  @@index([scanId, kind, capturedAt])
  @@index([sourceUrl])
}

model AiFinding {
  id                    String              @id @default(cuid())
  scanId                String
  organizationId        String
  merchantId            String
  title                 String
  severity              AiSeverity
  confidence            Float
  theme                 String
  category              String
  materiality           AiMateriality
  materialityWeight     Float
  commercialProminence  Float
  visualProminence      Float
  productAssociation    Boolean             @default(false)
  mitigation            Float               @default(0)
  ambiguous             Boolean             @default(false)
  contradictoryEvidence Boolean             @default(false)
  explanation           String
  affectedUrl           String
  contentType           String
  affectedProduct       String?
  affectedCategory      String?
  verifiedSku           String?
  remediation           String
  status                AiFindingStatus     @default(OPEN)
  criticStatus          AiCriticStatus      @default(NOT_REQUESTED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  scan                  AiScan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  merchant              Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  evidence              AiFindingEvidence[]
  criticReview          AiCriticReview?

  @@index([scanId, severity])
  @@index([merchantId, status, severity])
  @@index([organizationId, status])
}

model AiFindingEvidence {
  id         String         @id @default(cuid())
  findingId  String
  evidenceId String
  role       AiEvidenceRole
  rationale  String?
  finding    AiFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence   AiEvidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([findingId, evidenceId, role])
  @@index([evidenceId])
}

model AiProduct {
  id               String   @id @default(cuid())
  scanId           String
  canonicalUrl     String
  name             String
  sku              String?
  price            String?
  currency         String?
  variants         Json     @default("[]")
  categories       Json     @default("[]")
  objectiveSignals Json     @default("{}")
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  scan             AiScan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, canonicalUrl])
  @@index([scanId, verified])
}

model AiToolEvent {
  id            String       @id @default(cuid())
  scanId        String
  callId        String
  name          String
  status        AiToolStatus @default(REQUESTED)
  input         Json         @default("{}")
  outputSummary Json         @default("{}")
  evidenceCount Int          @default(0)
  durationMs    Int?
  error         String?
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  scan          AiScan       @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, callId])
  @@index([scanId, startedAt])
}

model AiCriticReview {
  id          String         @id @default(cuid())
  scanId      String
  findingId   String         @unique
  model       String
  status      AiCriticStatus @default(REQUESTED)
  result      Json           @default("{}")
  usage       Json           @default("{}")
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  scan        AiScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  finding     AiFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([scanId, status])
}

model SemanticAnalysis {
  id            String   @id @default(cuid())
  contentHash   String
  promptVersion String
  provider      String
  model         String
  configuration Json
  result        Json
  createdAt     DateTime @default(now())

  @@unique([contentHash, promptVersion, provider, model])
}

model EvidenceArtifact {
  id         String               @id @default(cuid())
  scanId     String
  scope      EvidenceScope
  kind       EvidenceArtifactKind
  url        String
  parentUrl  String?
  mimeType   String?
  httpStatus Int?
  storageKey String?
  sha256     String
  metadata   Json                 @default("{}")
  capturedAt DateTime             @default(now())
  scan       Scan                 @relation(fields: [scanId], references: [id], onDelete: Cascade)
  records    EvidenceRecord[]

  @@unique([scanId, scope, kind, url, sha256])
  @@index([scanId, scope, kind])
  @@index([sha256])
}

model EvidenceRecord {
  id              String                     @id @default(cuid())
  artifactId      String
  evidenceType    String
  exactText       String?
  value           Json?
  selector        String?
  jsonPointer     String?
  pageNumber      Int?
  coordinates     Json?
  contentHash     String
  createdAt       DateTime                   @default(now())
  artifact        EvidenceArtifact           @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  reviewLinks     ReviewEvidenceLink[]
  verifierLinks   VerificationEvidenceLink[]
  findingEvidence FindingEvidence[]

  @@unique([artifactId, evidenceType, contentHash])
  @@index([artifactId, evidenceType])
  @@index([contentHash])
}

model ReviewRun {
  id                String                 @id @default(cuid())
  scanId            String
  role              ReviewRunRole
  provider          String
  model             String
  promptVersion     String
  inputManifestHash String
  status            ReviewRunStatus        @default(RUNNING)
  configuration     Json                   @default("{}")
  output            Json                   @default("{}")
  usage             Json                   @default("{}")
  error             String?
  createdAt         DateTime               @default(now())
  completedAt       DateTime?
  scan              Scan                   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  observations      ReviewObservation[]
  criticDecisions   AdjudicationDecision[] @relation("CriticReview")

  @@index([scanId, role, createdAt])
  @@index([inputManifestHash, promptVersion, model])
}

model ReviewObservation {
  id                  String                 @id @default(cuid())
  reviewRunId         String
  issueKey            String
  domain              AssertionDomain
  category            String
  riskTheme           String
  classification      EvidenceClassification
  conclusion          String
  confidence          Float
  materiality         ReviewMateriality
  proposedSeverity    Severity?
  humanReviewRequired Boolean                @default(false)
  createdAt           DateTime               @default(now())
  reviewRun           ReviewRun              @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  evidence            ReviewEvidenceLink[]
  primaryDecisions    AdjudicationDecision[] @relation("PrimaryObservation")

  @@unique([reviewRunId, issueKey])
  @@index([issueKey, classification])
}

model ReviewEvidenceLink {
  id               String                 @id @default(cuid())
  observationId    String
  evidenceRecordId String
  role             ReviewEvidenceRole
  classification   EvidenceClassification
  rationale        String?
  observation      ReviewObservation      @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidenceRecord   EvidenceRecord         @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)

  @@unique([observationId, evidenceRecordId, role])
  @@index([evidenceRecordId])
}

model VerificationAssertion {
  id            String                     @id @default(cuid())
  scanId        String
  issueKey      String
  factType      String
  subjectId     String
  state         VerificationState
  value         Json                       @default("{}")
  methodVersion String
  createdAt     DateTime                   @default(now())
  scan          Scan                       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  evidence      VerificationEvidenceLink[]
  decisions     AdjudicationDecision[]

  @@unique([scanId, issueKey, methodVersion])
  @@index([scanId, factType, state])
}

model VerificationEvidenceLink {
  id                      String                @id @default(cuid())
  verificationAssertionId String
  evidenceRecordId        String
  assertion               VerificationAssertion @relation(fields: [verificationAssertionId], references: [id], onDelete: Cascade)
  evidenceRecord          EvidenceRecord        @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)

  @@unique([verificationAssertionId, evidenceRecordId])
  @@index([evidenceRecordId])
}

model AdjudicationDecision {
  id                      String                 @id @default(cuid())
  scanId                  String
  issueKey                String
  domain                  AssertionDomain
  material                Boolean
  outcome                 AdjudicationOutcome
  reason                  String
  scoreEligible           Boolean                @default(false)
  primaryObservationId    String?
  verificationAssertionId String?
  criticRunId             String?
  createdAt               DateTime               @default(now())
  scan                    Scan                   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  primaryObservation      ReviewObservation?     @relation("PrimaryObservation", fields: [primaryObservationId], references: [id])
  verificationAssertion   VerificationAssertion? @relation(fields: [verificationAssertionId], references: [id])
  criticRun               ReviewRun?             @relation("CriticReview", fields: [criticRunId], references: [id])
  finding                 Finding?

  @@unique([scanId, issueKey])
  @@index([scanId, outcome, scoreEligible])
}

