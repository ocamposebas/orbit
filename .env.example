DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit?schema=public
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
AI_PROVIDER=deterministic
AI_MODEL=local-context-v1
# Primary holistic merchant reviewer and independent disagreement critic.
AI_REVIEW_MODEL=gpt-5.6-luna
AI_CRITIC_MODEL=gpt-5.6-luna
AI_REVIEW_REASONING_EFFORT=high
DUAL_REVIEW_MODE=enforced
AI_REVIEW_MAX_INPUT_CHARS=850000
AI_REVIEW_MAX_RECORDS=5000
AI_REVIEW_MAX_IMAGES=40
AI_CRITIC_MAX_DISAGREEMENTS=20
AI_VISION_MODEL=gpt-4.1-mini
AI_DOCUMENT_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
AI_MAX_PAGE_CHARS=24000
AI_MAX_OUTPUT_TOKENS=3000
AI_PAGE_CONCURRENCY=3
AI_VISUAL_MAX_PAGES=12
AI_VISUAL_MAX_ASSETS_PER_PAGE=6
AI_VISUAL_MAX_IMAGE_BYTES=4000000
AI_DOCUMENT_MAX_FILES=12
AI_DOCUMENT_MAX_PAGES=20
AI_DOCUMENT_MAX_CHARS=40000
PUBLIC_API_MAX_RESPONSES=50
# anonymous_cart is limited to a fresh guest session and never submits checkout.
CHECKOUT_EXPLORATION_MODE=read_only
EXTERNAL_VERIFICATION_ENABLED=false
EXTERNAL_VERIFICATION_MAX_CLAIMS=10
# Optional pricing inputs used only for per-scan cost estimates in audit metadata.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
# Optional layer-specific rates; fall back to the two generic rates above.
AI_VISION_INPUT_COST_PER_MILLION=
AI_VISION_OUTPUT_COST_PER_MILLION=
AI_DOCUMENT_INPUT_COST_PER_MILLION=
AI_DOCUMENT_OUTPUT_COST_PER_MILLION=
SCREENSHOT_STORAGE=./storage/evidence
CRAWLER_MAX_PAGES=250
CRAWLER_MAX_DEPTH=4
CRAWLER_CONCURRENCY=3
CRAWLER_RESPONSE_LIMIT_BYTES=5000000
CRAWLER_NAVIGATION_TIMEOUT_MS=20000
INTERNAL_JOB_SECRET=replace-in-production
# Required for storing merchant integration secrets. Generate with: openssl rand -base64 32
ORBIT_SECRET_ENCRYPTION_KEY=
ORBIT_DEMO_MODE=true
SESSION_TTL_DAYS=14
SEED_ADMIN_EMAIL=admin@orbit.local
SEED_ADMIN_PASSWORD=change-this-demo-password
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MODE=test
STRIPE_CONNECT_ACCOUNT_API=v2
STRIPE_CONNECT_WEBHOOK_SECRET=
# Separate signing secret for connected-account PaymentIntent events.
STRIPE_PAYMENTS_WEBHOOK_SECRET=
# Optional. Leave unset to use the version bundled with the installed Stripe SDK.
STRIPE_API_VERSION=
