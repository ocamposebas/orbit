DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit?schema=public
REDIS_URL=redis://localhost:6379
# One origin, or canonical first plus one alternate origin separated by a comma.
APP_URL=http://localhost:3000
# APP_URL=https://orbit.example,https://alternate.example
# ORBIT AI Scanner v1. Luna is the only primary website investigator.
AI_SCANNER_MODEL=gpt-5.6-luna
# Optional; leave blank to disable dispute-only critic calls.
AI_CRITIC_MODEL=
AI_SCANNER_REASONING_EFFORT=high
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_SCANNER_REQUEST_TIMEOUT_MS=60000
# Request-local temporary rate-limit recovery. Retry-After takes precedence.
AI_SCANNER_OPENAI_MAX_RETRIES=5
AI_SCANNER_OPENAI_RETRY_BASE_MS=5000
AI_SCANNER_OPENAI_RETRY_MAX_MS=120000
AI_SCANNER_OPENAI_RETRY_TOTAL_MS=900000
AI_SCANNER_OPENAI_MAX_RESUMES=12
# Global investigation budgets. They are never treated as coverage targets.
AI_SCANNER_MAX_RUNTIME_MS=3600000
AI_SCANNER_MAX_TOOL_CALLS=400
AI_SCANNER_MAX_TOKENS=20000000
AI_SCANNER_MAX_COST_USD=50
AI_SCANNER_MAX_OUTPUT_TOKENS=32000
# Reserved headroom and larger output allowance for the final strict audit JSON.
AI_SCANNER_FINALIZATION_MAX_OUTPUT_TOKENS=64000
AI_SCANNER_FINALIZATION_TOKEN_RESERVE=400000
# Server-side Responses compaction keeps long tool/image audits inside the active context window.
AI_SCANNER_CONTEXT_COMPACT_THRESHOLD=200000
AI_SCANNER_MAX_EVIDENCE_BYTES=5000000
AI_SCANNER_INPUT_COST_PER_MILLION=0.2
AI_SCANNER_OUTPUT_COST_PER_MILLION=1.2
AI_SCANNER_BROWSER_HEADLESS=true
SCREENSHOT_STORAGE=./storage/evidence
INTERNAL_JOB_SECRET=replace-in-production
# Required for storing merchant integration secrets. Generate with: openssl rand -base64 32
ORBIT_SECRET_ENCRYPTION_KEY=
ORBIT_DEMO_MODE=true
SESSION_TTL_DAYS=14
SEED_ADMIN_EMAIL=admin@orbit.local
SEED_ADMIN_PASSWORD=change-this-demo-password
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Canonical Payment Method Configuration used by Elements, PaymentIntents, and Stripe Checkout.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
STRIPE_MODE=test
STRIPE_CONNECT_ACCOUNT_API=v2
STRIPE_CONNECT_WEBHOOK_SECRET=
# Separate signing secret for connected-account PaymentIntent events.
STRIPE_PAYMENTS_WEBHOOK_SECRET=
# Optional. Leave unset to use the version bundled with the installed Stripe SDK.
STRIPE_API_VERSION=

# Private Ecwid payment adapter. Leave disabled until every value is configured.
ECWID_ENABLED=false
ECWID_STORE_ID=
ECWID_CLIENT_ID=
ECWID_CLIENT_SECRET=
ECWID_SECRET_TOKEN=
ECWID_ORBIT_MERCHANT_ID=
# Optional Ecwid-only override. Defaults to STRIPE_PAYMENT_METHOD_CONFIGURATION_ID.
ECWID_STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# STRIPE_CHECKOUT is used by this private integration. ORBIT_HOSTED keeps /pay/[sessionId] available as a fallback.
ECWID_CHECKOUT_MODE=STRIPE_CHECKOUT
# Optional trusted callback origin for a payment subdomain. Defaults to APP_URL.
ECWID_PUBLIC_CHECKOUT_ORIGIN=
