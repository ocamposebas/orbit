{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prestart": "prisma migrate deploy",
    "start": "next start",
    "start:deploy": "prisma migrate deploy && next start",
    "lint": "eslint src tests vitest.config.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "worker:ai-scanner": "tsx src/workers/ai-scanner.ts",
    "workers": "tsx src/workers/all.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
