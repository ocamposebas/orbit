# The authenticated PDF route renders reports with Playwright. Keep this image
# version aligned with the `playwright` package in package.json so Chromium and
# its Linux dependencies are present in the web container after every deploy.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./

# Evita ejecutar prisma generate antes de copiar el schema.
RUN npm ci --ignore-scripts

COPY . .

# prisma.config.ts necesita que DATABASE_URL exista para generate,
# pero NO necesita conectarse durante este paso.
ENV DATABASE_URL="postgresql://orbit:orbit@127.0.0.1:5432/orbit"

RUN npx prisma generate
RUN npm run build

ENV NODE_ENV=production

EXPOSE 3000

# Apply committed, forward-only migrations before accepting traffic. Prisma's
# migration lock keeps concurrent deploys safe; a failed migration prevents the
# new application version from serving against an incompatible schema.
CMD ["npm", "run", "start:deploy"]
